# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================================

# Usuario de PostgreSQL
POSTGRES_USER=facial_user

# Contraseña de PostgreSQL (cambiar en producción)
POSTGRES_PASSWORD=facial_pass

# Nombre de la base de datos
POSTGRES_DB=facial_db

# Puerto de PostgreSQL (interno: 5432, externo desde host: 5433)
POSTGRES_PORT=5433

# URL de conexión a la base de datos
# IMPORTANTE: Desde Docker, usar @db:5432 (nombre del servicio + puerto interno)
# Desde máquina local, usar @localhost:5433 (puerto mapeado)
DATABASE_URL=postgresql://facial_user:facial_pass@db:5432/facial_db

# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================

# Host del servidor FastAPI
API_HOST=0.0.0.0

# Puerto del servidor FastAPI
API_PORT=8000

# Host del servidor Streamlit
STREAMLIT_HOST=0.0.0.0

# Puerto del servidor Streamlit
STREAMLIT_PORT=8501

# ============================================================
# CONFIGURACIÓN DE CÁMARAS
# ============================================================

# Tiempo máximo de espera para conexión a cámara (ms)
CAMERA_TIMEOUT_MS=3000

# Número máximo de reintentos de conexión
CAMERA_MAX_RETRIES=3

# Tiempo de espera entre reintentos (segundos)
CAMERA_RETRY_DELAY=2

# ============================================================
# LOGGING
# ============================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================
# EJEMPLOS DE URLs SOPORTADAS
# ============================================================

# RTSP (IP Camera) - Recomendado para cámaras IP
# RTSP_URL=rtsp://192.168.1.100:554/stream
# RTSP_USERNAME=admin
# RTSP_PASSWORD=password123

# HTTP (IP Camera)
# HTTP_URL=http://192.168.1.101:8080/video
# HTTP_USERNAME=admin
# HTTP_PASSWORD=password123

# HTTPS (IP Camera segura)
# HTTPS_URL=https://camera.example.com/video
# HTTPS_USERNAME=admin
# HTTPS_PASSWORD=password123

# Cámara local por índice (/dev/videoX en Linux)
# LOCAL_CAMERA_INDEX=0   # usa /dev/video0
# LOCAL_CAMERA_INDEX=1   # usa /dev/video1

# ============================================================
# AUTENTICACIÓN GOOGLE OAUTH
# ============================================================

# Client ID de Google Cloud Console (obtener en https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ============================================================
# RECONOCIMIENTO FACIAL
# ============================================================

# Tolerancia de distancia euclidiana para match facial (0.0 - 1.0)
FACE_MATCH_TOLERANCE=0.6
