# Database
# Nota: Puerto interno es 5432 (PostgreSQL), pero se expone al host en 5433
# Si necesitas conectar desde pgAdmin u otro cliente, usa puerto 5433
POSTGRES_USER=facial_user
POSTGRES_PASSWORD=facial_pass
POSTGRES_DB=facial_db
POSTGRES_PORT=5433

# App
DATABASE_URL=postgresql://facial_user:facial_pass@db:5432/facial_db
